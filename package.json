{
  "name": "linkedin-md",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that turns a LinkedIn profile into clean Markdown — copy it or download it as a .md file.",
  "license": "MIT",
  "keywords": [
    "chrome-extension",
    "linkedin",
    "markdown",
    "manifest-v3",
    "scraper"
  ],
  "homepage": "https://github.com/mehradamiri/linkedin-md#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mehradamiri/linkedin-md.git"
  },
  "bugs": {
    "url": "https://github.com/mehradamiri/linkedin-md/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.content.config.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write .",
    "zip": "pnpm build && cd dist && zip -r ../linkedin-md.zip ."
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/chrome": "^0.2.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "prettier": "^3.9.5",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
